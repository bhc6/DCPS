# DCPS-Compound — environment template.
# Copy to `.env` (gitignored) and fill in. Never commit real keys.
#   cp .env.example .env
#
# Every var below is read via os.getenv() by the example entrypoints; nothing is
# hardcoded. Placeholders are inert — the scripts raise RuntimeError on a missing
# key rather than silently running unauthenticated.

# ---------------------------------------------------------------------------
# OpenRouter (required). One key is enough: every per-benchmark var below falls
# back to OPENROUTER_API_KEY. Separate keys only exist to spread rate limits
# across concurrent runs.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Optional; defaults to OpenRouter's public endpoint when unset.
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Per-benchmark keys (all optional).
# OPENROUTER_API_KEY_HOTPOTQA=
# OPENROUTER_API_KEY_PUPA=
# OPENROUTER_API_KEY_HOVER=
# OPENROUTER_API_KEY_HOVER_BASE=
# OPENROUTER_API_KEY_IFBENCH=
# OPENROUTER_API_KEY_IFBENCH_BASE=
# OPENROUTER_API_KEY_AIME_MATH_FEWSHOT=
# OPENROUTER_API_KEY_AIME_MATH_AGNOSTIC=
# OPENROUTER_API_KEY_AIME_MATH_AGNOSTIC_NB=
# OPENROUTER_API_KEY_AIME_MATH_GPT41MINI=

# PUPA only: give each of the four roles (solver / prompt generator / LLM judge /
# untrusted external LLM) its own key. Each falls back to OPENROUTER_API_KEY_PUPA,
# then OPENROUTER_API_KEY. Note the judge and the untrusted LLM follow the
# backbone chosen by EXP_MODE — in qwen mode all four are qwen3-8b.
# OPENROUTER_API_KEY_PUPA_SOLVER=
# OPENROUTER_API_KEY_PUPA_GENERATOR=
# OPENROUTER_API_KEY_PUPA_JUDGE=
# OPENROUTER_API_KEY_PUPA_UNTRUSTED=

# ---------------------------------------------------------------------------
# Weights & Biases (optional). Runs log to wandb; unset it to run offline
# (`WANDB_MODE=offline`) or `wandb login` beforehand instead.
# ---------------------------------------------------------------------------
# WANDB_API_KEY=
# WANDB_MODE=offline

# ---------------------------------------------------------------------------
# Run configuration (optional — defaults reproduce the paper's main table).
# ---------------------------------------------------------------------------
# Backbone for the PUPA entrypoint: qwen | gpt. Default: qwen.
# EXP_MODE=qwen
# Search iterations. Default 20 = the paper's main-table budget.
# ITERATIONS=20        # HotpotQA entrypoints
# NUM_ITERATIONS=20    # PUPA entrypoint
# Eval concurrency. Defaults: 32, but 8 for the Qwen HotpotQA script (OOM).
# NUM_THREADS=32
